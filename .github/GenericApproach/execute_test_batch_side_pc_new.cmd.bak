) else if "%majorVersion%"=="3" (
    set nunitExecutable="C:\Program Files (x86)\NUnit.org\nunit-console\nunit3-console.exe"
) else (
    echo [ERROR] Unsupported NUnit version: %nunitVersion%
    exit /b 1
)

